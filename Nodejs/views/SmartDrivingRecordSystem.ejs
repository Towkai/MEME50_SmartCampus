<!-- <!DOCTYPE html> -->
<html>
<head>
    <meta charset="UTF-8">
    <title>FileHistroy</title>
    <script src="https://unpkg.com/axios/dist/axios.min.js"></script>
    <link rel="stylesheet" type="text/css" href="/css/explorer.css"></head>
</head>
<body>
    <h1>檔案總管</h1>
    <div class="file-explorer" id="fileExplorer">
        <% Data["d:multistatus"]["d:response"].slice(1).forEach(response => { %>
            <% const href = response["d:href"][0]; %>
            <% const isFolder = href.endsWith('/'); %>
            <div id="<%= href.split('/').pop() %>" class="item <%= isFolder ? 'folder' : 'file' %>">
                <span><%= isFolder ? '📁' : '📄' %> <%= href.split('/').pop() %></span>
                <div class="info">
                    <% if (isFolder) { %>
                        <span>大小: N/A</span>
                        <span>，最後修改時間: <%= response["d:propstat"][0]["d:prop"][0]["d:getlastmodified"][0] %></span>
                    <% } else { %>
                        <span>大小: <%= response["d:propstat"][0]["d:prop"][0]["d:getcontentlength"][0] %> bytes</span>
                        <span>，最後修改時間: <%= response["d:propstat"][0]["d:prop"][0]["d:getlastmodified"][0] %></span>
                    <% } %>
                    <!-- 新增刪除按鈕 -->
                    <button class="delete-button" data-href="<%= href %>">刪除</button>
                </div>
            </div>
        <% }); %>
    </div>
    <script src="/script/url.js"></script>
    <script src="/script/nextcloud.js"></script>
</body>
</html>